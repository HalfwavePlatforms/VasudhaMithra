# ── Database ──────────────────────────────────────────────
POSTGRES_USER=lrms_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=land_records
DATABASE_URL=postgresql://lrms_user:changeme@postgres:5432/land_records

# ── OCR ───────────────────────────────────────────────────
# Pick ONE. Cloud Vision has far better accuracy on Indic scripts than
# Tesseract; use Tesseract as a zero-cost/offline fallback.
OCR_PROVIDER=google_vision            # google_vision | tesseract
GOOGLE_VISION_API_KEY=

# ── Service URLs (used by api-gateway to call other services) ─
OCR_SERVICE_URL=http://ocr-pipeline:8001
EXTRACTION_SERVICE_URL=http://extraction-engine:8002
GIS_SERVICE_URL=http://gis-service:8003

# ── Frontend ──────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ── Deploy (only needed for hosted backup — see docs/deployment.md) ─
RAILWAY_PROJECT_ID=
